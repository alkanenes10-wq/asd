# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  .env.local olarak kopyalayıp doldurun.
#
#  Buradaki her anahtar İSTEĞE BAĞLI. Hiçbiri yokken seansapp DEMO MODDA,
#  örnek bir klinik günüyle çalışır — hemen gezebilirsiniz.
# ─────────────────────────────────────────────────────────────────────────────

# ── Uygulama ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (veritabanı & giriş) ────────────────────────────────────────────
# Hastalar, randevular, hekimler. https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar (çift yönlü senkron) ─────────────────────────────────────
# Hekimlerin kişisel takvimleriyle müsaitliği aynı tutar.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Twilio (SMS hatırlatma) ──────────────────────────────────────────────────
# Randevu hatırlatması ve yeniden randevu bağlantısı gönderir. https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Stripe (SaaS'a geçince) ──────────────────────────────────────────────────
# seansapp'in tek işi randevu almak; ödeme arayüzü app.config.ts içindeki
# features.payments bayrağıyla kapalı. Abonelik tahsilatına geçerken bu
# satırları açın ve bayrağı true yapın. https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
